node_modules/
.DS_Store
*.log
.env
.env.*
!.env.example
.wrangler/
dist/
build/
local.properties
.gradle/
*.jks
*.keystore
xcuserdata/
*.xcuserstate

# Generated by `xcodegen generate` from ios/project.yml. Committing it would
# create a second source of truth for the target's settings, and the two drift.
ios/*.xcodeproj/
.build/

# The signing private key, the certificate request and the .p12 bundle.
# Regenerable, but never in git.
ios/signing/.secrets/

# The Android upload key and the properties file that points at it.
# NOT regenerable once Play pins the upload certificate to the package name,
# and this repository is public, so a leak cannot be fixed by rotating.
# Written by scripts/pull-release-keystore.sh; backed up in Secret Manager.
android/app/*.p12
android/app/keystore.properties
